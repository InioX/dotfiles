spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "XDG_SESSION_TYPE"
spawn-at-startup "systemctl" "--user" "restart" "xdg-desktop-portal.service"

spawn-at-startup "sh" "-c" "qs --path ~/.config/quickshell/zenyte"
spawn-at-startup "xwayland-satellite"
spawn-at-startup "awww-daemon"
spawn-at-startup "wl-clip-persist" "--clipboard" "regular"

hotkey-overlay {
    // Uncomment this line to disable the "Important Hotkeys" pop-up at startup.
    skip-at-startup
}
